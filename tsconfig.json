{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2023",
    "lib": ["esnext"],

    "sourceMap": false,
    "declaration": true,
    "incremental": false,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strictNullChecks": false,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "paths": {
      "@beiifeng/nestjs-validator": ["./packages/nestjs-validator/src"],
      "@beiifeng/nestjs-validator/*": ["./packages/nestjs-validator/src/*"],
      "@beiifeng/nestjs-validator-plugin-swagger": ["./packages/nestjs-validator-plugin-swagger/src"],
      "@beiifeng/nestjs-validator-plugin-swagger/*": ["./packages/nestjs-validator-plugin-swagger/src/*"],
      "@beiifeng/nestjs-validator-typebox": ["./packages/nestjs-validator-typebox/src"],
      "@beiifeng/nestjs-validator-typebox/*": ["./packages/nestjs-validator-typebox/src/*"],
      "@beiifeng/nestjs-validator-zod": ["./packages/nestjs-validator-zod/src"],
      "@beiifeng/nestjs-validator-zod/*": ["./packages/nestjs-validator-zod/src/*"]
    }
  },
  "exclude": ["**/.*/", "**/build", "**/node_modules", "**/dist"]
}
