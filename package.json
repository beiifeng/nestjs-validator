  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^24.13.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
